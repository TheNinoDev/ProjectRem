# Copy this file to `.env` and fill in the values. `.env` is gitignored - never
# commit the real one. This template holds no secrets.
#
# Nothing here is needed to *run* the app: the built GUI talks to the deployed
# Worker over HTTPS and the Worker holds its own OAuth secrets. These variables
# only drive `push.bat` (deploying the Worker) and `build.bat` (publishing the
# GitHub release).

# Optional. wrangler can work it out from CLOUDFLARE_API_TOKEN, but setting it
# avoids an extra lookup on every deploy.
CLOUDFLARE_ACCOUNT_ID=

# --------------------------------------------------------------- Cloudflare
# Required by push.bat to deploy the Worker. Create one at
# https://dash.cloudflare.com/profile/api-tokens with the
# "Workers Scripts: Edit" permission.
CLOUDFLARE_API_TOKEN=

# The KV namespace that backs accounts, sessions, connections, tokens and bots.
# Create it with:
#   wrangler kv namespace create PR
# and copy the printed id here. push.bat stamps it into worker/wrangler.toml
# before deploying, so a value from a different account never gets committed.
CF_KV_NAMESPACE_ID=

# ------------------------------------------------------------------ GitHub
# Required by build.bat to create the release. It needs `repo` scope:
#   gh auth refresh -h github.com -s repo
GH_TOKEN=

# ------------------------------------------------------- OAuth applications
# These are *not* needed to run the app or push the Worker. The client ids are
# public and are already compiled into the GUI; the secrets live in the Worker
# as Worker secrets and must never appear in this file.
#
# To (re)set them, run this from the `worker\` directory:
#   wrangler secret put HF_CLIENT_ID
#   wrangler secret put HF_CLIENT_SECRET
#   wrangler secret put DC_CLIENT_ID
#   wrangler secret put DC_CLIENT_SECRET
#   wrangler secret put GH_CLIENT_ID
#   wrangler secret put GH_CLIENT_SECRET
#
# OAuth callback URLs registered with the providers:
#   http://localhost:53630/callback/hf
#   http://localhost:53630/callback/dc
#   http://localhost:53630/callback/gh
